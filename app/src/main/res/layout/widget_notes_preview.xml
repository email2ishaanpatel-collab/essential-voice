<?xml version="1.0" encoding="utf-8"?>
<!--
  What the widget picker shows. It has to be a separate layout because the real
  one is a ListView filled by a RemoteViewsService, and nothing fills it in the
  picker — the preview would be an empty card. So: the same card with two
  ordinary TextViews standing in for notes.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_surface"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_heading"
            android:textColor="@color/widget_ink_muted"
            android:textSize="11sp"
            android:letterSpacing="0.145"
            android:fontFamily="@font/geist_mono_medium" />

        <TextView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_add"
            android:gravity="center"
            android:text="@string/widget_add"
            android:textColor="#1B1B1D"
            android:textSize="17sp"
            android:fontFamily="@font/geist_regular" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/widget_preview_one"
        android:textColor="@color/widget_ink"
        android:textSize="14sp"
        android:fontFamily="@font/geist_regular" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:contentDescription="@null"
        android:background="@color/widget_divider" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/widget_preview_two"
        android:textColor="@color/widget_ink"
        android:textSize="14sp"
        android:fontFamily="@font/geist_regular" />
</LinearLayout>
