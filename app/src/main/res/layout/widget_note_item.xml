<?xml version="1.0" encoding="utf-8"?>
<!-- One note in the widget list: its first line, and when it was taken.
     Tapping it opens the note for editing — see NotesWidgetService. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_row"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/widget_item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_ink"
        android:textSize="14sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:fontFamily="@font/geist_regular" />

    <TextView
        android:id="@+id/widget_item_when"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/widget_ink_faint"
        android:textSize="10sp"
        android:letterSpacing="0.145"
        android:maxLines="1"
        android:fontFamily="@font/geist_mono_medium" />
</LinearLayout>
