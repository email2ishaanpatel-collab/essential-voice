<?xml version="1.0" encoding="utf-8"?>
<!-- The + button in the widget's header. Yellow, because it is the one thing
     in there that starts something. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#E8C500" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ev_yellow" />
        </shape>
    </item>
</selector>
