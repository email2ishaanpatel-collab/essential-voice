<?xml version="1.0" encoding="utf-8"?>
<!--
  Six dots on a ring, drawn to the proportions of the 1024px artwork *as it sits
  inside the circle* rather than to the adaptive-icon safe zone.

  The safe circle is 66 of the 108 units, but the mask a launcher actually cuts
  is 72, and sizing the mark to the safe zone made it fill nearly the whole
  visible circle — correct by the rules, wrong to look at, and cramped once a
  round mask went round it. So the geometry is taken straight from the artwork:
  a hexagon of radius 194/1024 and dots 58/1024 across, both scaled by the 72
  the eye actually sees. That is R = 13.64 and r = 2.04 about the centre.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#000000"
        android:pathData="M54.00,40.36 m-2.04,0 a2.04,2.04 0 1,0 4.08,0 a2.04,2.04 0 1,0 -4.08,0" />
